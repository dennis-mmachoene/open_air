# ============================================================================
#  Open Air — Environment Variables
# ----------------------------------------------------------------------------
#  Copy this file to .env.local and fill in what you need:
#      cp .env.example .env.local
#
#  • The app BOOTS WITH ZERO CONFIG — the public catalog runs off a static
#    snapshot. Everything below unlocks an additional subsystem.
#  • Validated by lib/env.ts (Zod). Never read process.env directly elsewhere.
#  • In PRODUCTION, DATABASE_URL and AUTH_SECRET are REQUIRED (deploy fails
#    closed). Each grouped subsystem is all-or-nothing: set every key in a
#    group, or none — half-configured groups fail the boot on purpose.
#  • NEXT_PUBLIC_* values are exposed to the browser. Never put secrets there.
#
#  How to obtain every value below: see  SETUP-KEYS.md
# ============================================================================


# ── Core ────────────────────────────────────────────────────────────────────
# Public base URL. Local dev: http://localhost:3000. For phone testing on your
# LAN use your machine's IP, e.g. http://192.168.1.20:3000 (also set AUTH_URL).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ── Database — Neon Postgres (REQUIRED in production) ───────────────────────
# Pooled connection string from the Neon dashboard. Needed for accounts,
# teams, billing, community, and the admin console.
DATABASE_URL=""


# ── Auth.js — session secret (REQUIRED in production) ───────────────────────
# Generate with:  npx auth secret      (or: openssl rand -base64 33)
AUTH_SECRET=""
# Only needed if the auth callback URL differs from NEXT_PUBLIC_SITE_URL
# (e.g. LAN IP testing). Usually leave unset.
# AUTH_URL="http://localhost:3000"


# ── Google OAuth (group: set BOTH or NEITHER) ───────────────────────────────
# Google Cloud Console → Credentials → OAuth client ID (Web application).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""


# ── Email / SMTP (group: set BOTH or NEITHER) ───────────────────────────────
# Powers magic-link sign-in + all transactional email (invites, receipts,
# proposal notifications). Nodemailer connection string.
#   Gmail (app password):  smtps://openair.mailer%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
#   Resend:                smtps://resend:RESEND_API_KEY@smtp.resend.com:465
#   Mailgun/Postmark/SES:   smtps://USER:PASS@smtp.provider.com:465
# Note: URL-encode '@' in a username as %40.
AUTH_EMAIL_SERVER=""
AUTH_EMAIL_FROM="Open Air <openair.mailer@gmail.com>"


# ── AI — Google Gemini (optional; falls back to local keyword matching) ─────
# Google AI Studio → Get API key.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"


# ── Stripe billing (group: set the SECRET, WEBHOOK + the two PRO prices) ─────
# Dashboard → Developers → API keys (use TEST keys for non-prod).
STRIPE_SECRET_KEY=""
# From `stripe listen` (local) or Dashboard → Webhooks → signing secret (prod).
STRIPE_WEBHOOK_SECRET=""
# Price IDs. Run `npm run stripe:setup` to create products + print these.
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
# Legacy Studio tier (optional — only for existing Studio subscribers).
STRIPE_PRICE_STUDIO_MONTHLY=""
STRIPE_PRICE_STUDIO_YEARLY=""


# ── Upstash Redis — distributed rate limiting (group: BOTH or NEITHER) ──────
# Upstash console → your Redis DB → REST API. Without it, limits fall back to
# per-instance memory (fine for single-instance / dev).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# ── Analytics — PostHog (optional) ──────────────────────────────────────────
# PostHog → Project settings → Project API Key. NEXT_PUBLIC = browser-exposed.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"


# ── Error monitoring — Sentry (group: set DSN + NEXT_PUBLIC_DSN together) ────
# Sentry → Project → Settings → Client Keys (DSN). Same DSN in both is fine.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Build-time source-map upload (optional, CI/deploy only):
# Sentry → Settings → Auth Tokens (scope: project:releases).
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""


# ── Security — Content-Security-Policy ──────────────────────────────────────
# Leave unset/false to ship CSP in Report-Only mode. Set to "true" to ENFORCE
# once you've watched the report stream and confirmed no false positives.
CSP_ENFORCE="false"


# ── System Administrator (/sys) bootstrap ───────────────────────────────────
# On first boot, when no platform admins exist, a Super Admin is seeded from
# these. Password must be 12+ chars. ROTATE after first sign-in (2FA enforced).
# Alternative: create one anytime with
#     npm run platform:admin -- create you@example.com "Your Name"
PLATFORM_BOOTSTRAP_EMAIL="openair.mailer@gmail.com"
PLATFORM_BOOTSTRAP_PASSWORD=""
PLATFORM_BOOTSTRAP_NAME="Super Admin"


# ── Legacy app-level admin allow-list (deprecated — retained for back-compat) ─
# The real admin is the isolated /sys console above. This is unused by it.
ADMIN_EMAILS="openair.mailer@gmail.com"
