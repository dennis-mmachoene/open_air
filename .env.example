# Open Air — environment variables
# Copy to .env.local and fill in. Values are validated by lib/env.ts (Zod).
# CLI scripts (seed, drizzle-kit) read .env.local via lib/load-env.ts.

# Public base URL (metadata, OG images, canonical links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database: Neon Postgres (Phase 1) ---
# Pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js (Phase 4) ---
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Google OAuth (console.cloud.google.com → Credentials → OAuth client ID).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email magic links via SMTP (Nodemailer). Use any SMTP provider, e.g.
#   Gmail:   smtp://USER:APP_PASSWORD@smtp.gmail.com:587
#   Mailtrap (dev): smtp://USER:PASS@sandbox.smtp.mailtrap.io:2525
AUTH_EMAIL_SERVER="smtp://USER:PASSWORD@smtp.host.com:587"
AUTH_EMAIL_FROM="Open Air <login@yourdomain.com>"

# --- AI: Google Gemini color concierge (optional) ---
# Get a key at https://aistudio.google.com/app/apikey
# Without it, the assistant falls back to local keyword matching.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# --- Sentry (optional; no-op until set) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Stripe (Phase 5) ---
# Secret + webhook signing secret from the Stripe dashboard.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Run `npm run stripe:setup` to create products/prices, then paste the ids:
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."
STRIPE_PRICE_STUDIO_MONTHLY="price_..."
STRIPE_PRICE_STUDIO_YEARLY="price_..."

# --- Upstash Redis (Phase 6: public API rate limiting; optional) ---
# Create a database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- AI: Gemini also used by the generator? no — see GEMINI_API_KEY above ---

# --- Admin console (/admin) ---
# Comma-separated emails granted admin access. Empty = no admins.
ADMIN_EMAILS="dennism.ramara@gmail.com"

# Optional: enables Sentry source-map upload at build time (readable stack
# traces). Without these, errors still report but traces are minified.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Security headers ---
# Set to "true" only after confirming the CSP report stream is clean in
# production. Until then the CSP is sent report-only (observe, don't block).
CSP_ENFORCE="false"

# --- Local network testing (phone on the same Wi-Fi) ---
# When testing from another device (e.g. an iPhone) via the dev server's
# Network URL, set BOTH of these to that LAN IP so auth redirects and email
# links resolve on the device (not localhost, which the phone can't reach):
#   NEXT_PUBLIC_SITE_URL="http://192.168.x.x:3000"
#   AUTH_URL="http://192.168.x.x:3000"
# (For Google sign-in also add that IP callback URL in Google Cloud Console.)
AUTH_URL=""
