{
  "name": "open_air",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Dennis Ramara",
    "url": "https://github.com/dennis-mmachoene"
  },
  "description": "Open Air \u2014 a living gallery of color. Designed & built by Dennis Ramara.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx lib/db/seed.ts",
    "palettes:snapshot": "tsx scripts/build-snapshot.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "verify:lockfile": "npm install --package-lock-only --ignore-scripts && git diff --exit-code package-lock.json",
    "platform:admin": "tsx scripts/platform-admin.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.58.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "culori": "^4.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.5",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.2.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@tailwindcss/postcss": "^4",
    "@types/culori": "^4.0.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
